# DropLync Environment Configuration Template

# Database Configuration (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication Security (Cryptographically secure random secret, min 32 characters)
JWT_SECRET="replace-with-a-random-32-byte-hex-secret-in-production"

# Private Upload Storage Directory (Must NOT be inside ./public)
UPLOAD_DIR="./storage/uploads"

# System Maintenance Cron Secret (Pass in x-cron-secret header)
CRON_SECRET="replace-with-a-random-64-char-hex-secret"

# Max File Size Limit in Bytes (100GB default)
MAX_FILE_SIZE=107374182400

# Public App Metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DropLync"
NEXT_PUBLIC_MAX_FILE_SIZE_MB=102400

# SMTP Email Configuration (Gmail App Password or Standard SMTP)
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="DropLync <noreply@droplync.com>"

# ClamAV Antivirus Daemon Configuration (TCP Socket INSTREAM)
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
# Policy when ClamAV daemon is unreachable: "fail_closed" (safer) or "fail_open"
CLAMAV_FALLBACK_MODE="fail_closed"

# Stripe Payment Configuration
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_endpoint_secret"
