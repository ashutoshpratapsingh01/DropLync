generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatar        String?
  role          String    @default("user")
  plan          String    @default("free") // "free", "pro", "ultra", "enterprise"
  planExpiresAt DateTime?
  brandColor    String?
  brandLogo     String?
  brandWallpaper String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  transfers     Transfer[]
  sessions      Session[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transfer {
  id              String    @id @default(cuid())
  token           String    @unique
  customSlug      String?   @unique
  uploadToken     String?   // Secret token for uploader chunk authorization (IDOR prevention)
  name            String?
  userId          String?
  senderEmail     String?
  recipientEmails String?
  deliveryMode    String    @default("link") // "link" | "email"
  emailMessage    String?
  passwordHash    String?
  expiresAt       DateTime
  maxDownloads    Int?
  downloadCount   Int       @default(0)
  isActive        Boolean   @default(true)
  totalSize       BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  files           TransferFile[]
  downloadLogs    DownloadLog[]
  emailLogs       EmailLog[]
}

model TransferFile {
  id            String   @id @default(cuid())
  transferId    String
  originalName  String
  relativePath  String?
  storagePath   String
  mimeType      String
  size          BigInt
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  transfer      Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  downloadLogs  DownloadLog[]
}

model DownloadLog {
  id         String        @id @default(cuid())
  transferId String
  fileId     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime      @default(now())
  transfer   Transfer      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  file       TransferFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  code      String
  type      String    @default("auth") // auth, login, register
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([email, code])
}

model EmailLog {
  id          String    @id @default(cuid())
  recipient   String
  sender      String?
  subject     String
  type        String    // "otp", "transfer_notification", "transfer_receipt"
  status      String    @default("sent") // "sent", "logged_dev", "failed"
  error       String?
  transferId  String?
  metadata    String?
  createdAt   DateTime  @default(now())

  transfer    Transfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([recipient])
  @@index([type])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  key        String    @unique
  name       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String   @default("transfer.created,transfer.downloaded")
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id // e.g. evt_...
  type      String
  createdAt DateTime @default(now())
}
